RewriteEngine On

# ============================================================
# PROTEÇÃO DE ARQUIVOS SENSÍVEIS
# ============================================================

<FilesMatch "^(\.env|\.git|\.htaccess|\.htpasswd|composer\.(json|lock)|package(-lock)?\.json)$">
    Require all denied
</FilesMatch>

# ============================================================
# ARQUIVOS FÍSICOS
# ============================================================

# Se o arquivo realmente existir, não passa pelo React
RewriteCond %{REQUEST_FILENAME} -f
RewriteRule ^ - [L]

# ============================================================
# ROTAS REACT
# ============================================================

# /jogos e todas as suas subrotas
RewriteRule ^jogos(?:/.*)?$ /index.html [L]

# /extensoes e todas as suas subrotas
RewriteRule ^extensoes(?:/.*)?$ /index.html [L]