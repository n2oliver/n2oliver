DirectoryIndex index.html index.php

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # =========================================================
    # ARQUIVOS FÍSICOS
    # =========================================================
    # Se o arquivo realmente existir, entrega diretamente.
    # Vale para PHP, HTML, CSS, JS, imagens, PDFs etc.
    RewriteCond %{REQUEST_FILENAME} -f
    RewriteRule ^ - [L]

    # =========================================================
    # REGRAS EXISTENTES
    # =========================================================

    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^(virtuals|casinoet|jackpots|onlinetsbonusesr).* /database/module-lib.php [L]

    # =========================================================
    # ROTAS DO REACT
    # =========================================================

    RewriteRule ^jogos(?:/.*)?$ /index.html [L]
    RewriteRule ^extensoes(?:/.*)?$ /index.html [L]

    # =========================================================
    # FALLBACK DO REACT
    # =========================================================
    # Qualquer rota que não seja arquivo/diretório físico
    # será entregue ao React.
    
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^ /index.html [L]
</IfModule>

# =============================================================
# PROTEÇÃO DE ARQUIVOS SENSÍVEIS
# =============================================================

<FilesMatch "^(\.env|\.git|composer\.json|composer\.lock|\.htaccess)$">
    Order allow,deny
    Deny from all
</FilesMatch>

# =============================================================
# HEADERS
# =============================================================

<IfModule mod_headers.c>
    Header set Permissions-Policy "browsing-topics=()"
</IfModule>