RewriteEngine On

# ============================================================
# PROTEÇÃO DE ARQUIVOS SENSÍVEIS
# ============================================================

<FilesMatch "^(\.env|\.git|\.htaccess|\.htpasswd|composer\.(json|lock)|package(-lock)?\.json)$">
    Require all denied
</FilesMatch>

# ============================================================
# ARQUIVOS FÍSICOS
# ============================================================

# Se o arquivo realmente existir, entrega o arquivo
# e não passa pelo React.
RewriteCond %{REQUEST_FILENAME} -f
RewriteRule ^ - [L]

# ============================================================
# SPA - REACT / VITE
# ============================================================

# Qualquer rota que não seja um arquivo físico
# será entregue ao React.
RewriteRule ^ /index.html [L]