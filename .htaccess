DirectoryIndex index.html index.php

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # =========================================================
    # PHP / regras existentes
    # =========================================================

    # Não reescrever o index.php
    RewriteRule ^index\.php$ - [L]

    # Regras existentes do sistema
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^(virtuals|casinoet|jackpots|onlinetsbonusesr).* /database/module-lib.php [L]


    # =========================================================
    # Arquivos e diretórios físicos
    # =========================================================

    # Se for um arquivo real, entrega normalmente
    RewriteCond %{REQUEST_FILENAME} -f
    RewriteRule ^ - [L]

    # Se for um diretório real, deixa o Apache tratar normalmente
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]


    # =========================================================
    # React / Vite / React Router
    # =========================================================

    # Qualquer URL que não seja arquivo ou diretório físico
    # será entregue ao React.
    RewriteRule ^ index.html [QSA,L]

</IfModule>


# =============================================================
# Proteção de arquivos sensíveis
# =============================================================

<FilesMatch "^(\.env|\.git|composer\.json|composer\.lock|\.htaccess)$">
    Order allow,deny
    Deny from all
</FilesMatch>


# =============================================================
# Security Headers
# =============================================================

<IfModule mod_headers.c>
    Header set Permissions-Policy "browsing-topics=()"
</IfModule>