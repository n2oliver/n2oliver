{
  "name": "N2oliver",
  "version": "0.1.0",
  "private": true,
  "dependencies": {
    "@fortawesome/fontawesome-free": "^7.3.1",
    "@testing-library/dom": "^10.4.1",
    "bootstrap": "^5.3.8",
    "hammerjs": "^2.0.8",
    "jquery": "^3.7.1",
    "jquery-ui": "^1.14.2",
    "react": "^19.2.7",
    "react-bootstrap": "^2.10.10",
    "react-dom": "^19.2.7",
    "react-router-dom": "^7.18.1",
    "react-toastify": "^11.1.0",
    "swiper": "^14.0.7"
  },
  "scripts": {
    "dev": "vite --host",
    "build": "vite build && copyfiles -u 1 \"api/**/*\" dist/api && copyfiles -u 1 \"src/css/**/*\" dist/css && copyfiles \".env\" dist/ && copyfiles \".htaccess\" dist/",
    "preview": "vite preview",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:run": "vitest run"
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "allowScripts": {
    "core-js@3.49.0": true,
    "core-js-pure@3.49.0": true
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@vitejs/plugin-react": "^6.0.5",
    "copyfiles": "^2.4.1",
    "jsdom": "^30.0.1",
    "vite": "^8.2.1",
    "vitest": "^4.1.10"
  }
